# ---- Database (persistent MySQL on the host) ----
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=autopilot
DB_PASSWORD=CHANGE_ME
DB_NAME=autopilot

# ---- Auth ----
SECRET_KEY=GENERATE_random_hex_32
ENCRYPTION_KEY=GENERATE_random_hex_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
TOKEN_TTL_HOURS=24

# ---- Published ports (host side) ----
FRONTEND_PORT=3010
BACKEND_PORT=8010

# ---- Monitoring thresholds ----
MONITOR_INTERVAL=60
CPU_THRESHOLD=90
MEM_THRESHOLD=90
DISK_THRESHOLD=85
LOAD_PER_CORE_THRESHOLD=2.0
METRICS_RETENTION_DAYS=7

# ---- Local AI (issues / actions / solutions) ----
AI_BASE_URL=http://10.195.102.52:8000/v1
AI_API_KEY=your-ai-key
# NOTE: model IDs are case-sensitive on this vLLM endpoint.
# Available: glm-5.1-awq, deepseek-v4-flash
AI_MODEL=glm-5.1-awq

# ---- Clawdbot (operational chat) ----
CLAWDBOT_BASE_URL=http://10.127.1.23:18789/v1
CLAWDBOT_API_KEY=
CLAWDBOT_MODEL=
CHAT_ALLOW_COMMANDS=true

# ---- On-demand pentesting (HexStrike AI) ----
# OFF by default. Set PENTEST_ENABLED=true to allow scans. Scans only ever target
# the stored IP of a server you've registered (fleet-only).
PENTEST_ENABLED=false
# Where the HexStrike engine (https://github.com/0x4m4/hexstrike-ai) lives.
#  - bundled service:   http://hexstrike:8888   (docker compose --profile pentest up)
#  - external instance: http://<scanner-host>:8888
HEXSTRIKE_BASE_URL=http://hexstrike:8888
HEXSTRIKE_API_KEY=
HEXSTRIKE_PORT=8888
HEXSTRIKE_TIMEOUT=900
# Intrusive/exploitation profiles (sqlmap, etc.). Can disrupt live services.
PENTEST_ALLOW_AGGRESSIVE=false
PENTEST_MAX_CONCURRENT=2
